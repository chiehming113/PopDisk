    "Already used by another app" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已被其他 App 使用"
          }
        }
      }
    },
    "Apps using the disk may lose unsaved changes, and files being copied may be damaged." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在使用這顆硬碟的 App 可能會遺失未儲存的變更，正在拷貝的檔案也可能損毀。"
          }
        }
      }
    },
