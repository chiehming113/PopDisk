    "Eject" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出"
          }
        }
      }
    },
    "Eject All" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部退出"
          }
        }
      }
    },
    "Eject Selected" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出選取的硬碟"
          }
        }
      }
    },
    "Eject all external drives" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出所有外接硬碟"
          }
        }
      }
    },
    "Eject all external drives (⇧⌘E)" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出所有外接硬碟（⇧⌘E）"
          }
        }
      }
    },
    "Eject external drives before the Mac sleeps" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 睡眠前自動退出外接硬碟"
          }
        }
      }
    },
    "Eject notifications only appear when the menu is closed, for example after using a shortcut or before sleep." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出的通知只會在選單關閉時出現，例如用快捷鍵退出或睡眠前自動退出時。"
          }
        }
      }
    },
    "Ejecting before sleep prevents damage if you unplug a drive while the Mac is asleep. Disk images are left mounted." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠前先退出，就算在 Mac 睡眠時拔掉硬碟也不會損壞資料。磁碟映像檔不會被退出。"
          }
        }
      }
    },
    "End Process" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束"
          }
        }
      }
    },
    "End the process, then try ejecting again" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束這個程式，然後再試一次退出"
          }
        }
      }
    },
    "Enter a full address, for example smb://my-nas.local/Photos." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入完整位址，例如 smb://my-nas.local/Photos。"
          }
        }
      }
    },
    "Ethernet" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "乙太網路"
          }
        }
      }
    },
    "Ethernet is connected at only 100 Mb/s or less. Check the cable or switch." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線速度受限：乙太網路只連到 100 Mb/s 以下。請檢查網路線或交換器。"
          }
        }
      }
    },
