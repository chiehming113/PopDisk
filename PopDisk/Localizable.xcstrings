      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "硬碟"
          }
        }
      }
    },
    "Drives you connect will appear here." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接過的硬碟會出現在這裡。"
