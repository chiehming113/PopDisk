    "Disconnect" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中斷連線"
          }
        }
      }
    },
    "Disk" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟"
          }
        }
      }
    },
    "Download and upload speed of the whole network connection, including other apps" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整個網路連線的下載與上傳速度（包含其他 App 的流量）"
          }
        }
      }
    },
    "Drag to change the order in the menu. Pinned drives always appear first. Nicknames and icons only change how drives look in PopDisk." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳可以調整在選單中的順序，釘選的硬碟永遠排在最前面。暱稱和圖示只會改變在 PopDisk 中的樣子，不會更改硬碟本身。"
          }
        }
      }
    },
    "Drag to Reorder" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳以調整順序"
          }
        }
      }
    },
    "Drive connected" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已接上硬碟"
          }
        }
      }
    },
